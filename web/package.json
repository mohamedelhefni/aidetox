{
  "name": "aidetox",
  "private": true,
  "type": "module",
  "scripts": {
    "go:wasm": "cd yaegi && GOOS=js GOARCH=wasm go build -ldflags='-s -w' -o ../public/yaegi.wasm . && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" ../public/ && cd ../public && split -b 16m yaegi.wasm yaegi.wasm. && rm yaegi.wasm",
    "dev": "vite",
    "build": "npm run go:wasm && vite build",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "marked": "^18.0.14",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
